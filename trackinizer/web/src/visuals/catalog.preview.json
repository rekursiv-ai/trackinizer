        "direction_limit": {"type": "integer", "default": 8, "minimum": 1, "maximum": 12, "max_length": null},
        "results_per_direction": {"type": "integer", "default": 3, "minimum": 1, "maximum": 5, "max_length": null}
      }
    },
    {
      "type": "trax.artifact",
      "version": 1,
      "title": "Artifact",
      "description": "Read immutable shared Artifact content.",
      "requires": ["record"],
      "default_size": "wide",
      "parameter_schema": {}
    }
  ]
}

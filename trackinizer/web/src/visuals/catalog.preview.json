{
  "default_visual": "trax.browse",
  "visuals": [
    {
      "type": "trax.browse",
      "version": 1,
      "title": "Browse",
      "description": "Browse trax records by kind and query.",
      "requires": [],
      "default_size": "wide",
      "parameter_schema": {},
      "record_kinds": []
    },
    {
      "type": "trax.subgraph",
      "version": 1,
      "title": "Context graph",
      "description": "See a record in context: what lies near it, in the graph.",
      "requires": [
        "record"
      ],
      "default_size": "wide",
      "parameter_schema": {
        "hops": {"type": "integer", "default": 2, "minimum": 1, "maximum": 3, "max_length": null},
        "highlight": {"type": "string", "default": "", "minimum": null, "maximum": null, "max_length": 512}
      },
      "record_kinds": null
    },
    {
      "type": "trax.timeline",
      "version": 1,
      "title": "Lineage and timeline",
      "description": "Any record by date, under its lead issues, over its directions, results, and signed evidence.",
      "requires": ["record"],
      "default_size": "wide",
      "parameter_schema": {
        "direction_limit": {"type": "integer", "default": 8, "minimum": 1, "maximum": 12, "max_length": null},
        "results_per_direction": {"type": "integer", "default": 3, "minimum": 1, "maximum": 5, "max_length": null}
      },
      "record_kinds": null
    },
    {
      "type": "trax.artifact",
      "version": 1,
      "title": "Artifact",
      "description": "Read immutable shared Artifact content.",
      "requires": ["record"],
      "default_size": "wide",
      "parameter_schema": {},
      "record_kinds": ["Artifact"]
    },
    {
      "type": "trax.summary",
      "version": 1,
      "title": "Campaign summary",
      "description": "What a campaign did, for readers who may not read its transcripts: its sessions, steps, phases and beliefs.",
      "requires": ["record"],
      "default_size": "wide",
      "parameter_schema": {},
      "record_kinds": ["Issue", "AgentSession"]
    },
    {
      "type": "trax.files",
      "version": 1,
      "title": "Files",
      "description": "A record's files and what changed in them, each change with its diff.",
      "requires": ["record"],
      "default_size": "wide",
      "parameter_schema": {
        "path": {"type": "string", "default": "", "minimum": null, "maximum": null, "max_length": 512},
        "changed": {"type": "boolean", "default": false, "minimum": null, "maximum": null, "max_length": null},
        "file": {"type": "string", "default": "", "minimum": null, "maximum": null, "max_length": 512}
      },
      "record_kinds": null
    },
    {
      "type": "trax.terminal",
      "version": 1,
      "title": "Terminal",
      "description": "A shell on one of your own machines. It starts only when you click Start terminal.",
      "requires": [],
      "default_size": "wide",
      "parameter_schema": {
        "machine": {"type": "string", "default": "", "minimum": null, "maximum": null, "max_length": 63},
        "start": {"type": "boolean", "default": false, "minimum": null, "maximum": null, "max_length": null}
      },
      "record_kinds": null
    }
  ]
}
